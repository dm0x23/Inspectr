{
  "name": "inspectr",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:server": "bun --cwd apps/server run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "build": "bun --cwd apps/web run build",
    "test": "bun --cwd apps/server run test"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
